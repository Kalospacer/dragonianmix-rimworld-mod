        <titleShort>Cellarmaster</titleShort>
        <baseDesc>[PAWN_nameDef] brews by the old methods, coaxing the finest flavour from every vintage by precisely controlling cellar temperature.</baseDesc>
        <skillGains>
            <Cooking>12</Cooking>
            <Plants>7</Plants>
            <Construction>4</Construction>
            <Medicine>-3</Medicine>
        </skillGains>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>    <!-- Dragonian Herald -->
