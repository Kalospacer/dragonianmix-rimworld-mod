            <Artistic>11</Artistic>
            <Social>7</Social>
            <Intellectual>5</Intellectual>
            <Shooting>-4</Shooting>
        </skillGains>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
