<?xml version="1.0" encoding="utf-8"?>
<Defs>    <!-- Dragonian Scribe -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Scribe</defName>
        <title>Dragonian Scribe</title>
        <titleShort>Archivist</titleShort>
        <baseDesc>[PAWN_nameDef] served as a record keeper in a lord's manor, preserving important documents with specially mixed ink. Her scales keep parchment safe from damp and from insects.</baseDesc>
        <skillGains>
            <Intellectual>10</Intellectual>
            <Artistic>6</Artistic>
            <Social>4</Social>
            <Plants>-3</Plants>
        </skillGains>
        <forcedTraitsChance>
            <li>
                <defName>FastLearner</defName>
                <chance>80</chance>
            </li>
        </forcedTraitsChance>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>    <!-- Dragonian Brewer -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Brewer</defName>
