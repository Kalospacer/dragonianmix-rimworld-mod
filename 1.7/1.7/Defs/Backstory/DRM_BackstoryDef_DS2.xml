<?xml version="1.0" encoding="utf-8"?>
<Defs>    <!-- Dragonian Miller -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Miller</defName>
        <title>Dragonian Miller</title>
        <titleShort>Grain Expert</titleShort>
        <baseDesc>[PAWN_nameDef] runs the watermill by the river and reads the current to judge the fineness of the grind, keeping every sack of flour even.</baseDesc>
        <skillGains>
            <Plants>8</Plants>
            <Cooking>6</Cooking>
            <Construction>4</Construction>
            <Social>-3</Social>
        </skillGains>
        <forcedTraitsChance>
            <li>
                <defName Degree="1">Industriousness</defName>
                <chance>80</chance>
            </li>
        </forcedTraitsChance>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>    <!-- Dragonian Shepherdess -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Shepherdess</defName>
        <title>Dragonian Shepherdess</title>
        <titleShort>Flock Keeper</titleShort>
        <baseDesc>[PAWN_nameDef] knows the seasonal migration routes by heart, and the wool she works is prized for its dense weave.</baseDesc>
        <skillGains>
            <Animals>10</Animals>
            <Crafting>5</Crafting>
            <Social>4</Social>
            <Intellectual>-2</Intellectual>
        </skillGains>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>    <!-- Dragonian Tailor -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Tailor</defName>
        <title>Dragonian Tailor</title>
        <titleShort>Clothier</titleShort>
        <baseDesc>[PAWN_nameDef] cuts clothing for every climate, and the double-stitch method she devised greatly extends how long a garment lasts.</baseDesc>
        <skillGains>
            <Crafting>11</Crafting>
            <Artistic>6</Artistic>
            <Social>3</Social>
            <Mining>-4</Mining>
        </skillGains>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>    <!-- Dragonian Potter -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Potter</defName>
        <title>Dragonian Potter</title>
        <titleShort>Vessel Maker</titleShort>
        <baseDesc>[PAWN_nameDef] knows the high-fire glaze recipes, turning out pottery that is as serviceable as it is handsome.</baseDesc>
        <skillGains>
            <Crafting>9</Crafting>
            <Artistic>7</Artistic>
            <Plants>3</Plants>
            <Medicine>-3</Medicine>
        </skillGains>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>    <!-- Dragonian Blacksmith -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Blacksmith</defName>
        <title>Dragonian Blacksmith</title>
        <titleShort>Metalworker</titleShort>
        <baseDesc>[PAWN_nameDef] forges farm tools famed for outlasting their owners, and the replaceable sickle head she designed cut the cost of farming sharply.</baseDesc>
        <skillGains>
            <Crafting>12</Crafting>
            <Mining>6</Mining>
            <Construction>4</Construction>
            <Social>-4</Social>
        </skillGains>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>    <!-- Dragonian Baker -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Baker</defName>
        <title>Dragonian Baker</title>
        <titleShort>Baking Expert</titleShort>
        <baseDesc>[PAWN_nameDef] developed several fermentation methods, and loaves made her way keep for two weeks without spoiling.</baseDesc>
        <skillGains>
            <Cooking>10</Cooking>
            <Plants>6</Plants>
            <Social>3</Social>
            <Artistic>-3</Artistic>
        </skillGains>
        <forcedTraitsChance>
            <li>
                <defName>Gourmand</defName>
                <chance>30</chance>
            </li>
        </forcedTraitsChance>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>    <!-- Dragonian Fisher -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Fisher</defName>
        <title>Dragonian Fisher</title>
        <titleShort>Angler</titleShort>
        <baseDesc>[PAWN_nameDef] knows how the shoals move in nearby waters, and the smoked fish she cures is standard supply for long caravan runs.</baseDesc>
        <skillGains>
            <Plants>9</Plants>
            <Cooking>7</Cooking>
            <Animals>4</Animals>
            <Artistic>-2</Artistic>
        </skillGains>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>    <!-- Dragonian Carpenter -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Carpenter</defName>
        <title>Dragonian Carpenter</title>
        <titleShort>Timber Expert</titleShort>
        <baseDesc>[PAWN_nameDef] is a master of treating lumber against rot, and the mortise-and-tenon houses she designs stand against hard winds.</baseDesc>
        <skillGains>
            <Construction>11</Construction>
            <Crafting>6</Crafting>
            <Plants>4</Plants>
            <Medicine>-3</Medicine>
        </skillGains>
        <forcedTraitsChance>
            <li>
                <defName Degree="1">Industriousness</defName>
                <chance>100</chance>
            </li>
        </forcedTraitsChance>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>    <!-- Dragonian Herbalist -->
    <AlienRace.AlienBackstoryDef ParentName="DragonianBackStory_Adulthood">
        <defName>Dragonian_Herbalist</defName>
        <title>Dragonian Herbalist</title>
        <titleShort>Plant Scholar</titleShort>
        <baseDesc>[PAWN_nameDef] compiled a herbal compendium listing over two hundred medicinal plants, and the salves she mixes work wonders on bruises and sprains.</baseDesc>
        <skillGains>
            <Plants>12</Plants>
            <Medicine>8</Medicine>
            <Intellectual>4</Intellectual>
            <Shooting>-4</Shooting>
        </skillGains>
        <spawnCategories>
            <li>Dragonian_spawnCategoriesA</li>
        </spawnCategories>
    </AlienRace.AlienBackstoryDef>
</Defs>